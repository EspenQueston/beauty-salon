# ---------------------------------------------------------------------------
# Configuration de production. Copie de travail : `.env`, a cote de ce
# fichier, jamais versionnee (voir .gitignore).
#
# Ne pas remplir les secrets a la main : `scripts/generer-env.sh` cree `.env`
# a partir de ce modele et tire chacun d'eux au hasard. Il ne reste alors a
# saisir que l'e-mail et les cles de services tiers.
# ---------------------------------------------------------------------------

# --- Domaine ----------------------------------------------------------------
# Tout le routage en depend : plateforme sur le domaine nu, espace pro sur
# `app.`, API sur `api.`, un sous-domaine par salon.
#
# Provisoire : sslip.io, service gratuit qui fait pointer tout nom contenant
# une adresse IP vers cette adresse. `65-21-157-38.sslip.io`, et chacun de
# ses sous-domaines, arrive donc sur le serveur, sans DNS a configurer.
#
# Pour passer a un vrai domaine : deux enregistrements A (`@` et `*`) vers
# 65.21.157.38, puis changer cette ligne et relancer `scripts/deployer.sh`.
PLATFORM_DOMAIN=65-21-157-38.sslip.io

# Adresse a laquelle Let's Encrypt previent avant l'expiration d'un
# certificat, si le renouvellement automatique echouait. Obligatoire.
ACME_EMAIL=

# Comment on entre sur la machine :
#   direct   Caddy tient lui-meme les ports 80 et 443 ;
#   coolify  Coolify les tient deja : on passe par son Traefik, sans
#            toucher a ses autres services (voir compose.coolify.yml).
# Detecte par scripts/generer-env.sh.
ENTREE=
#
# Le meme script ajoute COMPOSE_FILE (`compose.yml`, ou
# `compose.yml:compose.coolify.yml` en mode coolify) : les commandes
# `docker compose` tapees a la main dans ce dossier prennent ainsi les memes
# fichiers que `deployer.sh`. Jamais vide : une valeur vide casse toutes les
# commandes `docker compose`, d'ou son absence de ce modele.

# --- Secrets : generes par scripts/generer-env.sh ---------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
SALON_ADMIN_PASSWORD=
SALON_APP_PASSWORD=
# Partage entre Next et l'API : voir apps/api/apps/common/throttling.py.
INTERNAL_API_TOKEN=
# Chemin de l'administration plateforme, avec la barre finale. Tire au
# hasard pour ne pas figurer dans les balayages automatiques de `/admin/`.
# Ce n'est pas une protection — la double authentification en est une.
ADMIN_PATH=

# --- E-mail (obligatoire) ---------------------------------------------------
# L'inscription d'un salon envoie un message : sans serveur SMTP, elle
# echoue. Le chiffrement se deduit du port (465 = SSL, 587 = STARTTLS).
#
# Un mot de passe qui contient `$`, `#` ou une espace s'ecrit entre
# apostrophes — EMAIL_HOST_PASSWORD='a$b#c' — sinon Docker Compose en lit
# une partie comme une variable ou un commentaire.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Notifications push (Web Push) ------------------------------------------
# Paire generee par scripts/generer-env.sh. La regenerer invalide tous les
# abonnements existants : ne la changer qu'en connaissance de cause.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exige par la norme, sous forme `mailto:` ; repris d'ACME_EMAIL.
VAPID_SUBJECT=

# --- Services tiers (facultatifs : chacun eteint une fonction, pas le site) -
# Traduction du contenu des salons vers l'anglais, et assistants IA (offre Pro).
OPENAI_API_KEY=
# Assistant WhatsApp (offre Pro) : l'API Evolution deja installee sur le
# serveur. URL publique ou interne de l'API, et sa cle globale
# (AUTHENTICATION_API_KEY dans la configuration d'Evolution).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Adresse IPv4 du serveur, vers laquelle pointent les domaines personnalises
# des salons (offre Pro). Vide : lue dans le DNS de PLATFORM_DOMAIN.
PLATFORM_PUBLIC_IPS=
# Conversion d'un catalogue quand un salon change de devise.
CURRENCY_API_KEY=
# Suivi des erreurs.
SENTRY_DSN=
