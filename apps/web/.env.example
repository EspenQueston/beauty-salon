# Configuration du frontend.
#
# Copiez ce fichier en `.env.local` (non versionne) si vous changez les ports
# ou le domaine. Sans lui, les valeurs ci-dessous s'appliquent par defaut :
# une installation locale standard n'a donc rien a faire ici.
#
# Ces valeurs doivent rester coherentes avec le `.env` a la racine du depot.

NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_WEB_PORT=3100
NEXT_PUBLIC_API_PORT=8001

# URL de l'API vue depuis le serveur Next (rendu des mini-sites). Reste en
# 127.0.0.1 : cet appel ne traverse ni le navigateur ni un proxy.
INTERNAL_API_URL=http://127.0.0.1:8001

# En production uniquement : impose l'URL publique de l'API. Laissee vide en
# local, le navigateur deduit l'API de l'hote de la page.
NEXT_PUBLIC_API_URL=
