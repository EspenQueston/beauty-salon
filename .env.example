# ---------------------------------------------------------------------------
# Domaine plateforme. Tout le routage multi-tenant en depend.
#
# En local on utilise `localhost` : les navigateurs resolvent nativement
# n'importe quel sous-domaine de .localhost vers la boucle locale (RFC 6761),
# sans DNS, sans fichier hosts, et sans passer par un eventuel proxy.
#   blondrose.localhost   mini-site du salon
#   app.localhost         espace professionnel
#   localhost             site de la plateforme
# ---------------------------------------------------------------------------
PLATFORM_DOMAIN=localhost
WEB_PORT=3100
API_PORT=8001

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True

# --- Mise en production ----------------------------------------------------
# Basculez sur `config.settings.production` : c'est lui qui impose HTTPS, les
# cookies `Secure`, HSTS et les origines de confiance. Il *refuse de
# demarrer* si la cle secrete est absente, trop courte, ou restee a la valeur
# de developpement — un deploiement qui ne demarre pas se voit, une cle de
# developpement en production, non.
#
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DJANGO_SECRET_KEY=<64 caracteres tires au hasard, voir ci-dessous>
#   PLATFORM_DOMAIN=mon-domaine.com
#
# Generer la cle :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Reglages facultatifs, avec leurs valeurs par defaut :
#   SECURE_SSL_REDIRECT=True      mettre a False si le proxy redirige deja
#   SECURE_HSTS_SECONDS=31536000  un an, sous-domaines compris
#   SECURE_HSTS_PRELOAD=False     irreversible plusieurs mois : ne cocher
#                                 qu'une fois le certificat verifie sur
#                                 *tous* les sous-domaines
#   PLATFORM_ADMIN_MFA_REQUIRED=True   ne jamais passer a False : un compte
#                                 plateforme contourne les politiques RLS

# Connexion applicative : soumise aux politiques RLS (NOBYPASSRLS).
DATABASE_URL=postgres://salon_app:salon_app@localhost:5432/salon
# Connexion privilegiee : migrations, admin plateforme, taches inter-tenants.
DATABASE_ADMIN_URL=postgres://salon_admin:salon_admin@localhost:5432/salon

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- E-mail ----------------------------------------------------------------
# Par defaut : Mailpit, qui capture tout en local sans rien envoyer
# (http://localhost:8025). C'est le bon reglage pour developper.
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@localhost

# Serveur reel : renseignez ces quatre lignes. Le chiffrement se deduit du
# port (465 = SSL, 587 = STARTTLS), il n'y a rien d'autre a poser.
# L'expediteur doit appartenir au domaine authentifie, sinon SPF et DMARC
# feront classer les messages en indesirables.
# EMAIL_HOST=mail.exemple.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=contact@exemple.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Beauty Salon <contact@exemple.com>

# --- Observabilite (optionnel : inactif si vide) ---------------------------
SENTRY_DSN=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_API_PORT=8001
# Laissee vide en local : le navigateur deduit l'URL de l'API de l'hote de la
# page. A renseigner explicitement en production.
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://127.0.0.1:8001

# --- Notifications push (Web Push / VAPID) ---------------------------------
# Paire de cles propre a chaque installation, a engendrer une fois :
#
#   cd apps/api && uv run python -c "
#   from py_vapid import Vapid01
#   from cryptography.hazmat.primitives import serialization
#   import base64
#   v = Vapid01(); v.generate_keys()
#   b64 = lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')
#   print('VAPID_PRIVATE_KEY=' + b64(v.private_key.private_bytes(
#       serialization.Encoding.DER, serialization.PrivateFormat.PKCS8,
#       serialization.NoEncryption())))
#   print('VAPID_PUBLIC_KEY=' + b64(v.public_key.public_bytes(
#       serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))
#   "
#
# Laissees vides, le centre de notifications fonctionne toujours dans
# l'onglet ouvert : seul le push sur l'appareil est desactive, et aucun
# abonnement n'est propose. Une installation sans cles perd le telephone
# verrouille, pas la fonctionnalite.
#
# Regenerer la paire invalide **tous** les abonnements existants.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact exigee par la norme : les services de push des
# navigateurs s'en servent pour signaler un probleme au responsable.
VAPID_SUBJECT=mailto:contact@example.com

# Traduction du contenu des salons vers l'anglais, au moment ou le salon
# enregistre son texte. Sans cle : rien n'est traduit, et les mini-sites
# servent le francais — une degradation, pas une panne.
OPENAI_API_KEY=
